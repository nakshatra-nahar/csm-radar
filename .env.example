# Copy to .env and export (e.g. `set -a; . ./.env; set +a`). Defaults suit local demo only.
RADAR_OWNER_DSN=postgresql://postgres:postgres@localhost:54329/radar
RADAR_WEB_PASSWORD=change-me-web
RADAR_WORKER_PASSWORD=change-me-worker
# Optional: override the DSNs derived from RADAR_OWNER_DSN + the passwords above.
# RADAR_WEB_DSN=
# RADAR_WORKER_DSN=
RADAR_SECRET_KEY=change-me
RADAR_DEMO_PASSCODE=change-me
# Leave empty to use template briefs only.
ANTHROPIC_API_KEY=
RADAR_LLM_MODEL=claude-haiku-5-5
RADAR_DATA_DIR=data
# files: read the demo feed from RADAR_DATA_DIR/feed; db: from feed_buffer (serverless).
FEED_SOURCE=files
# Webhook signing keys: key_id:secret, comma separated.
RADAR_WEBHOOK_SECRETS=hearthline-1:change-me,tallyworks-1:change-me,kitewire-1:change-me
# Tests: admin DSN used to create and drop a throwaway database.
RADAR_TEST_ADMIN_DSN=postgresql://postgres:postgres@localhost:54329/postgres
# Tests: pg_dump/pg_restore folder matching the test server's major version (radar push).
# RADAR_TEST_PG_BIN=/opt/homebrew/opt/postgresql@16/bin
# /internal/tick bearer (Vercel cron sends CRON_SECRET; set both to the same value).
TICK_SECRET=
TICK_BUDGET_S=240
# production: the session cookie is sent over HTTPS only.
RADAR_ENV=development
